# Supabase
# LOCAL DEVELOPMENT USES THE SHARED `dev` BRANCH, NEVER PRODUCTION. Don't fill
# these by hand — pull them:
#     vercel env pull .env.local --environment=development
# `npm run dev` refuses to start if this URL is the production project
# (scripts/check-dev-env.mjs). docs/ENVIRONMENTS.md has the whole picture.
# Uses the new key format: sb_publishable_... (browser-safe).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...) — DO NOT expose to the browser.
# Only set this on the server when an operation truly requires it (e.g.
# admin-only background jobs). RLS-aware features should use the
# publishable key.
SUPABASE_SECRET_KEY=

# Password for the five dev_* test accounts on the dev database (12+ chars).
# `npm run seed:dev` applies it. Pick your own; it is never committed — this
# repository is public, so no credential of any kind belongs in a tracked file.
DEV_SEED_PASSWORD=

# AI assistant
# Used by the in-creator AI helper when no AI_GATEWAY_API_KEY is set (the
# gateway key below covers every AI feature on its own). With neither key the
# panel renders disabled buttons + an "AI not configured" note; the rest of
# the app still works. Get one at https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=

# Optional override of the model the AI assistant uses.
# Defaults to anthropic/claude-haiku-4.5 — small, fast, good enough for card text.
# Switch to anthropic/claude-sonnet-4.5 for higher-quality balance notes / concepts.
# Accepts gateway strings ("anthropic/claude-sonnet-4.5") or bare IDs ("claude-sonnet-4.5").
AI_CARD_MODEL=

# OpenAI — MODERATION ONLY. Used solely for the free omni-moderation image
# scan on HUMAN uploads (see bottom of this file). OpenAI is NEVER used to
# GENERATE images — all AI image generation goes through the AI Gateway
# (see AI_GATEWAY_API_KEY below). Leave unset to skip the moderation scan
# (it fails open). Get one at https://platform.openai.com/api-keys.
OPENAI_API_KEY=

# Card-design engine (lib/ai/card-design.ts) ---------------------------------
# Powers card/deck generation TEXT. Uses AI Gateway string model IDs.
# Requires one of: AI_GATEWAY_API_KEY, ANTHROPIC_API_KEY, or OPENAI_API_KEY.
# Gateway key provides unified access to all providers and additional features.
AI_GATEWAY_API_KEY=

# Optional model overrides for the design engine. Accept either a gateway
# string ("anthropic/claude-sonnet-4.5") or a bare id ("claude-sonnet-4.5",
# "gpt-4o"). Defaults: anthropic/claude-sonnet-4.5 designs, anthropic/claude-haiku-4.5 judges.
AI_DESIGN_MODEL=
AI_JUDGE_MODEL=

# Image models (lib/ai/image-gen.ts). ALL image generation goes through the AI
# Gateway — there is NO direct-OpenAI image path. AI_GATEWAY_API_KEY (above) is
# therefore REQUIRED for any image generation (deck/card art, AI remix); if
# it's unset those flows return a clear "AI Gateway isn't configured" error
# instead of silently (and expensively) falling back to gpt-image-1.
#   AI_IMAGE_MODEL       — text-to-image for card/deck/set art (default
#                          bfl/flux-2-flex — cheap, fast, style-consistent).
#   AI_IMAGE_REMIX_MODEL — image-to-image restyle for "AI remix" (default
#                          google/gemini-2.5-flash-image).
AI_IMAGE_MODEL=
AI_IMAGE_REMIX_MODEL=

# Scryfall — we identify ourselves in the User-Agent so Scryfall can rate-
# limit us correctly. Optional; defaults to "PipGlyph/1.0 (+<site>)".
SCRYFALL_USER_AGENT=

# Site URL — absolute base used for Stripe success/cancel redirects, OG images,
# sitemap, etc. Set this in production (e.g. https://www.pipglyph.com). Falls back
# to Vercel's deploy URL, then http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=

# IndexNow (lib/seo/indexnow.ts) — pushes new/changed public card and deck
# URLs to Bing & co. (what ChatGPT search / Copilot read from) the moment they
# change. Production only: any 8–128 char [a-zA-Z0-9-] key, served back at
# /indexnow-key.txt for verification. Leave unset locally and on previews.
INDEXNOW_KEY=

# Google Analytics 4 — set the GA4 measurement ID (G-XXXXXXXXXX) to enable
# analytics. Unset = no GA script is loaded at all (local dev, previews, e2e).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Billing master switch. Leave unset/false to keep the entire paid layer HIDDEN
# (no pricing page, no upgrade CTAs, no credit limits, no watermark) while
# retaining all the infrastructure. Set to "true" — with Stripe configured below
# — to go live. NEXT_PUBLIC_ so both server and client read it.
NEXT_PUBLIC_BILLING_ENABLED=

# Stripe (premium subscriptions + credit packs) ------------------------------
# Get keys at https://dashboard.stripe.com/apikeys. Use a RESTRICTED key in
# production. Without STRIPE_SECRET_KEY the billing UI shows "not available"
# and the rest of the app works normally.
STRIPE_SECRET_KEY=

# Webhook signing secret from `stripe listen` (dev) or the Dashboard endpoint
# (prod). The webhook route verifies every event against this.
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (create Products → Prices in the Dashboard). Each paid tier
# has a monthly + an annual recurring price ("2 months free"); packs are
# one-time. These map to the keys in lib/billing/plans.ts. They are the FIRST
# match for price→tier resolution, not the only one: also set `tier=plus` /
# `tier=pro` in each product's metadata so a price recreated in the Dashboard
# or chosen through the Customer Portal still maps (see BILLING_SETUP.md §2).
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_PACK_SMALL=
STRIPE_PRICE_PACK_LARGE=

# Cron secret — Vercel sends this as `Authorization: Bearer <CRON_SECRET>` to
# the scheduled routes (/api/cron/refill-credits, /api/cron/reconcile-credits)
# and it also gates the admin rebake sweep (/api/admin/rebake).
# Generate a long random string; set it in the Vercel project env.
CRON_SECRET=

# Local-only escape hatch: lets /api/admin/rebake run without the CRON_SECRET
# bearer. Never set this in a deployed environment — and think twice locally
# while .env.local points at the production database.
ALLOW_UNAUTHENTICATED_REBAKE=

# Moderation alerts (optional) ------------------------------------------------
# When a user files a content report, admins are pinged via any channel that's
# configured. All are best-effort — a delivery failure never fails the report.
#
# Slack: create an Incoming Webhook (https://api.slack.com/messaging/webhooks)
# and paste the URL here.
SLACK_WEBHOOK_URL=
#
# Email via Resend (https://resend.com). RESEND_API_KEY + ADMIN_ALERT_EMAIL are
# both required to enable email; ADMIN_ALERT_FROM must be a verified Resend
# sender/domain (defaults to Resend's onboarding sender, which only delivers to
# the account owner in test mode).
RESEND_API_KEY=
ADMIN_ALERT_EMAIL=
ADMIN_ALERT_FROM=

# Image content scan (NSFW auto-scan on HUMAN uploads: card art, profile
# media, watermarks, custom pips — AI-generated art is not scanned; providers
# filter upstream) reuses OPENAI_API_KEY above via the free omni-moderation
# model. No extra key needed; if OPENAI_API_KEY is unset the scan is skipped
# (fails open).

# Environments (docs/ENVIRONMENTS.md) -----------------------------------------
# With Supabase branching enabled, migrations apply automatically (preview
# branch per PR; production on merge). These refs feed the MANUAL FALLBACK
# scripts only:
#   npm run db:push:prod     — out-of-band prod push (asks for confirmation);
#                              the shared dev branch has its own target-verified
#                              script (npm run db:push:dev), which needs no ref
#                              or password here
# The ref is the subdomain of the project's supabase.co URL. Refs aren't
# secrets, but they live here (not in the repo) so a fresh clone can't push
# migrations anywhere by accident.
SUPABASE_PROD_REF=

# --- Render assets (frame PNGs) -----------------------------------------------
# public/frames (~163 MB) is NOT bundled into functions on Vercel; the bake
# fetches each frame it needs from the deployment's own static CDN and caches
# it in memory (lib/render/card-frames.ts). Both are optional:
#   RENDER_ASSET_ORIGIN — explicit origin to fetch /frames/… from (defaults to
#     the site URL, then VERCEL_PROJECT_PRODUCTION_URL). Local dev reads the
#     files from disk and never fetches.
#   VERCEL_AUTOMATION_BYPASS_SECRET — Vercel's "Protection Bypass for
#     Automation" secret. Preview deployments sit behind Vercel Authentication;
#     with this set a preview fetches its OWN frames, without it a preview
#     falls through to production's copy (only matters for a PR that changes
#     a frame PNG).
RENDER_ASSET_ORIGIN=
VERCEL_AUTOMATION_BYPASS_SECRET=
