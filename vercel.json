{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "crons": [
    {
      "path": "/api/cron/refill-credits",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/reconcile-credits",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/notify-render-updates",
      "schedule": "45 6 * * *"
    },
    {
      "path": "/api/cron/email-digest",
      "schedule": "0 15 * * 1"
    },
    {
      "path": "/api/cron/prune-funnel-events",
      "schedule": "15 7 * * 1"
    },
    {
      "path": "/api/cron/auto-rebake",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/publish-articles",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/comp-ending",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/cron/referral-rewards",
      "schedule": "20 * * * *"
    }
  ]
}
